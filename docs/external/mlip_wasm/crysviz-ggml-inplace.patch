diff --git a/src/ggml-alloc.c b/src/ggml-alloc.c
index 7f414b23..49d8947f 100644
--- a/src/ggml-alloc.c
+++ b/src/ggml-alloc.c
@@ -35,13 +35,20 @@ bool ggml_op_can_inplace(enum ggml_op op) {
         case GGML_OP_LOG:
         case GGML_OP_UNARY:
         case GGML_OP_ROPE:
+        case GGML_OP_RMS_NORM:
+        case GGML_OP_SOFT_MAX:
+            return true;
+
+        // Not in place: the CPU kernels of RMS_NORM_BACK (copies x into dst
+        // before reading the gradient) and SOFT_MAX_BACK (overwrites y before
+        // multiplying by it) read an input after writing dst, and the WebGPU
+        // backend binds these backward ops' inputs and output separately
+        // (aliasing a read-only and a writable binding is invalid).
         case GGML_OP_ROPE_BACK:
         case GGML_OP_SILU_BACK:
-        case GGML_OP_RMS_NORM:
         case GGML_OP_RMS_NORM_BACK:
-        case GGML_OP_SOFT_MAX:
         case GGML_OP_SOFT_MAX_BACK:
-            return true;
+            return false;
 
         default:
             return false;
