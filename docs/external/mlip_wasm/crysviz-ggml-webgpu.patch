+// f32 x f32 matrix product (CrysViz): 64 threads per workgroup, a 32 x 32
+// output tile, each thread a 4 x 4 block held in four vec4 registers.
+//
+// Same parameters, bindings and batching as mul_mat_reg_tile.wgsl. That kernel
+// keeps an 8 x 8 accumulator array (and an 8-element src0 tile) per thread,
+// indexed in loops and passed by value: where a browser's WGSL compiler does
+// not unroll those loops (Firefox and Safari guard every loop against running
+// forever), the arrays go to per-thread memory, and every multiply-add is a
+// load and a store. Here no per-thread array exists: the accumulators are
+// named vec4s and the inner loop reads two vec4s from workgroup memory. The
+// smaller tile also gives four times the workgroups on the narrow matrices
+// of interatomic potentials (a few hundred rows of output at most per atom
+// count of columns).
+
+struct MulMatParams {
+    offset_src0: u32,
+    offset_src1: u32,
+    offset_dst: u32,
+    m: u32,
+    n: u32,
+    k: u32,
+    stride_01: u32,
+    stride_11: u32,
+    stride_02: u32,
+    stride_12: u32,
+    stride_03: u32,
+    stride_13: u32,
+    bs02: u32,
+    bs03: u32,
+    broadcast2: u32,
+    broadcast3: u32
+};
+
+@group(0) @binding(0) var<storage, read_write> src0: array<f32>; // M rows, K columns
+@group(0) @binding(1) var<storage, read_write> src1: array<f32>; // N rows, K columns
+@group(0) @binding(2) var<storage, read_write> dst: array<f32>;  // N rows, M columns
+
+@group(0) @binding(3) var<uniform> params: MulMatParams;
+
+const WG_M = 8u;      // threads along m
+const WG_N = 8u;      // threads along n
+const BLOCK = 4u;     // outputs per thread along m and along n
+const TILE = 32u;     // WG_M * BLOCK == WG_N * BLOCK
+const TK = 16u;       // k per shared-memory step
+const THREADS = 64u;  // WG_M * WG_N
+
+// [k][m] and [k][n]: a thread's 4 rows (columns) are 4 consecutive floats.
+var<workgroup> sh0: array<f32, 512>; // TK * TILE
+var<workgroup> sh1: array<f32, 512>;
+
+fn store4(base: u32, row0: u32, v: vec4<f32>) {
+    if (row0 < params.m) { dst[base] = v.x; }
+    if (row0 + 1u < params.m) { dst[base + 1u] = v.y; }
+    if (row0 + 2u < params.m) { dst[base + 2u] = v.z; }
+    if (row0 + 3u < params.m) { dst[base + 3u] = v.w; }
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(workgroup_id) wg_id: vec3<u32>,
+        @builtin(local_invocation_id) local_id: vec3<u32>,
+        @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let t = local_id.x;
+    let lm = t % WG_M;
+    let ln = t / WG_M;
+
+    let wg_m_count = (params.m + TILE - 1u) / TILE;
+    let wg_n_count = (params.n + TILE - 1u) / TILE;
+    let wg_per_matrix = wg_m_count * wg_n_count;
+    let wg_linear = wg_id.y * num_wg.x + wg_id.x;
+    let batch_idx = wg_linear / wg_per_matrix;
+    let total_batches = params.bs02 * params.broadcast2 * params.bs03 * params.broadcast3;
+    if (batch_idx >= total_batches) {
+        return;
+    }
+    let wg_in_batch = wg_linear % wg_per_matrix;
+    let offset_m = (wg_in_batch % wg_m_count) * TILE;
+    let offset_n = (wg_in_batch / wg_m_count) * TILE;
+
+    let dst2_stride = params.m * params.n;
+    let dst3_stride = dst2_stride * params.bs02 * params.broadcast2;
+    let dst3_idx = batch_idx / (params.bs02 * params.broadcast2);
+    let dst2_idx = batch_idx % (params.bs02 * params.broadcast2);
+    let src0_base = params.offset_src0 + (dst3_idx / params.broadcast3) * params.stride_03
+        + (dst2_idx / params.broadcast2) * params.stride_02;
+    let src1_base = params.offset_src1 + dst3_idx * params.stride_13 + dst2_idx * params.stride_12;
+
+    var acc0 = vec4<f32>(0.0);
+    var acc1 = vec4<f32>(0.0);
+    var acc2 = vec4<f32>(0.0);
+    var acc3 = vec4<f32>(0.0);
+
+    for (var k0 = 0u; k0 < params.k; k0 += TK) {
+        // 512 values of each tile, 8 per thread; consecutive threads read
+        // consecutive k of a row (k is contiguous in both inputs).
+        for (var j = 0u; j < 8u; j++) {
+            let e = j * THREADS + t;
+            let r = e / TK;
+            let kk = e % TK;
+            let gk = k0 + kk;
+            let gm = offset_m + r;
+            let gn = offset_n + r;
+            var v0 = 0.0;
+            if (gm < params.m && gk < params.k) {
+                v0 = src0[src0_base + gm * params.stride_01 + gk];
+            }
+            var v1 = 0.0;
+            if (gn < params.n && gk < params.k) {
+                v1 = src1[src1_base + gn * params.stride_11 + gk];
+            }
+            sh0[kk * TILE + r] = v0;
+            sh1[kk * TILE + r] = v1;
+        }
+        workgroupBarrier();
+        for (var kk = 0u; kk < TK; kk++) {
+            let ia = kk * TILE + lm * BLOCK;
+            let ib = kk * TILE + ln * BLOCK;
+            let a = vec4<f32>(sh0[ia], sh0[ia + 1u], sh0[ia + 2u], sh0[ia + 3u]);
+            let b = vec4<f32>(sh1[ib], sh1[ib + 1u], sh1[ib + 2u], sh1[ib + 3u]);
+            acc0 += a * b.x;
+            acc1 += a * b.y;
+            acc2 += a * b.z;
+            acc3 += a * b.w;
+        }
+        workgroupBarrier();
+    }
+
+    let dst_base = params.offset_dst + dst3_idx * dst3_stride + dst2_idx * dst2_stride;
+    let row0 = offset_m + lm * BLOCK;
+    let col0 = offset_n + ln * BLOCK;
+    if (col0 < params.n) { store4(dst_base + col0 * params.m + row0, row0, acc0); }
+    if (col0 + 1u < params.n) { store4(dst_base + (col0 + 1u) * params.m + row0, row0, acc1); }
+    if (col0 + 2u < params.n) { store4(dst_base + (col0 + 2u) * params.m + row0, row0, acc2); }
+    if (col0 + 3u < params.n) { store4(dst_base + (col0 + 3u) * params.m + row0, row0, acc3); }
+}
