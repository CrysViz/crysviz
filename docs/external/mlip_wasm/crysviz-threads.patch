@@ -11,6 +14,38 @@
 
 namespace mlipcpp {
 
+namespace {
+int g_wasm_cpu_threads = -1; // -1: not set yet, resolve lazily
+// The CPU backend most recently created under Emscripten, so a later
+// set_wasm_cpu_threads() reaches a model that is already loaded (ggml reads
+// the count at every graph compute, so it can change between predictions).
+ggml_backend_t g_wasm_last_cpu_backend = nullptr;
+}
+
+int wasm_cpu_threads() {
+#if defined(__EMSCRIPTEN__) && defined(__EMSCRIPTEN_PTHREADS__)
+  if (g_wasm_cpu_threads < 1) {
+    int n = emscripten_num_logical_cores();
+    if (n < 1) n = 1;
+    if (n > 8) n = 8;
+    g_wasm_cpu_threads = n;
+  }
+  return g_wasm_cpu_threads;
+#else
+  return 1;
+#endif
+}
+
+void set_wasm_cpu_threads(int n) {
+  g_wasm_cpu_threads = n < 1 ? 1 : n;
+#if defined(__EMSCRIPTEN__) && defined(__EMSCRIPTEN_PTHREADS__)
+  if (g_wasm_last_cpu_backend) {
+    ggml_backend_cpu_set_n_threads(g_wasm_last_cpu_backend, g_wasm_cpu_threads);
+  }
+#endif
+}
