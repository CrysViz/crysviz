 // Emscripten bindings
+// --- CPU thread control -----------------------------------------------------
+// The CPU backend runs the ggml graph on this many threads. Only the pthreads
+// build can use more than one (SharedArrayBuffer, cross-origin isolated page);
+// the single-threaded build reports 1 and ignores the setter. Takes effect
+// from the next prediction, also for a model that is already loaded.
+static int getNumThreads() {
+    return mlipcpp::wasm_cpu_threads();
+}
+// The link pre-starts min(logical cores, 16) workers (PTHREAD_POOL_SIZE in
+// rebuild.sh): a thread beyond the pool would need its worker started while
+// the graph compute blocks this thread waiting for it, which never happens in
+// a browser (deadlock; Chrome reports 14 cores on an M-series Pro).
+static const int kMaxWasmThreads = 16;
+static int getMaxThreads() {
+#ifdef __EMSCRIPTEN_PTHREADS__
+    int n = emscripten_num_logical_cores();
+    if (n > kMaxWasmThreads) n = kMaxWasmThreads;
+    return n > 0 ? n : 1;
+#else
+    return 1;
+#endif
+}
+static int setNumThreads(int n) {
+#ifdef __EMSCRIPTEN_PTHREADS__
+    int maxn = getMaxThreads();
+    if (n < 1) n = 1;
+    if (n > maxn) n = maxn;
+    mlipcpp::set_wasm_cpu_threads(n);
+    return n;
+#else
+    (void)n;
+    return 1;
+#endif
+}
+static bool hasThreads() {
+#ifdef __EMSCRIPTEN_PTHREADS__
+    return true;
+#else
+    return false;
+#endif
+}
+
