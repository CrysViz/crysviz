+      // Adaptive cutoff chain rule. The per-pair cutoffs depend on the edge
+      // distances through the adaptive cutoff math done here in C++, which
+      // the model's autograd does not see. With C[e] = ∂E/∂cutoff_values[e]
+      // (cutoff_values was marked as a ggml param) and the analytic Jacobian
+      // J[e] = ∂atomic_cutoffs[k]/∂d_e (k the centre of edge e), edge e of the
+      // full list carries the extra gradient ∂E/∂r_e = 0.5 J[e] S[k] r_e / d_e,
+      // where S[k] sums C over the model's edges touching k (cutoff_values =
+      // 0.5 (a_i + a_j)). It enters the forces here and the virial below.
+      // Skipped when adaptive cutoff isn't active.
+      std::vector<double> adaptive_coef;  // per full_nlist edge
+      if (have_adaptive && cutoff_values_t) {
+        ggml_tensor *cv_grad = ggml_graph_get_grad(cgraph, cutoff_values_t);
+        if (cv_grad && cv_grad->data) {
+          std::vector<float> cv_grad_data(ggml_nelements(cv_grad));
+          ggml_backend_tensor_get(cv_grad, cv_grad_data.data(), 0,
+                                  ggml_nbytes(cv_grad));
+
+          // S[k] = Σ_e (in filtered list, edge e touches atom k) C_e
+          std::vector<double> S(n_atoms, 0.0);
+          for (int ca = 0; ca < n_atoms; ca++) {
+            for (int slot = 0; slot < max_neighbors; slot++) {
+              int flat_idx = ca * max_neighbors + slot;
+              if (pm_data[flat_idx] > 0.5f) continue;
+              int na = neighbor_atoms_vec[flat_idx];
+              if (na < 0) continue;
+              double c = static_cast<double>(cv_grad_data[flat_idx]);
+              S[ca] += c;
+              S[na] += c;
+            }
+          }
+
+          const int n_probes = adapt_cache.n_probes;
+          const auto &probes = adapt_cache.probes;
+          const auto &X = adapt_cache.diff_jacobian;
+          const float ew = adapt_cache.effective_width;
+
+          adaptive_coef.assign(full_nlist.num_pairs(), 0.0);
+          for (int e = 0; e < full_nlist.num_pairs(); e++) {
+            int k = full_nlist.centers[e];
+            double d = static_cast<double>(full_nlist.distances[e]);
+            if (d <= 0.0) continue;
+            // J[e] = Σ_p X[k, p] * bump_derivative(d, probes[p], ew)
+            double J = 0.0;
+            const double *Xk = &X[static_cast<size_t>(k) * n_probes];
+            for (int p = 0; p < n_probes; p++) {
+              J += Xk[p] * bump_derivative(static_cast<float>(d),
+                                           probes[p], ew);
+            }
+            if (J == 0.0) continue;
+            const double coef = 0.5 * J * S[k] / d;
+            adaptive_coef[e] = coef;
+            // r_e = x_j - x_k (+ shift): F_k += ∂E/∂r_e, F_j -= ∂E/∂r_e,
+            // as for the model's own edge gradients above.
+            const int j = full_nlist.neighbors[e];
+            const auto &r = full_nlist.edge_vectors[e];
+            for (int c = 0; c < 3; c++) {
+              const float g = static_cast<float>(coef * r[c]);
+              result.forces[k * 3 + c] += g;
+              result.forces[j * 3 + c] -= g;
+            }
+          }
+        }
+      }
+
       // Apply energy scale
       for (int i = 0; i < n_atoms * 3; i++) {
         result.forces[i] *= energy_scale_;
@@ -990,67 +1054,23 @@ ModelResult GraphModel::predict_single(
