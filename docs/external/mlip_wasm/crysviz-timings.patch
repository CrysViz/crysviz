+// --- Timings (CrysViz) ------------------------------------------------------
+// Where the last GraphModel prediction spent its time, in ms; the gpu* fields
+// only in the WebGPU build. For finding fixed per-step costs in a browser.
+extern "C" {
+extern double mlipcpp_graph_timing_ms[6];
+__attribute__((weak)) extern double ggml_webgpu_timing_ms[4];
+}
+static val getLastTimings() {
+    val t = val::object();
+    t.set("inputsMs", mlipcpp_graph_timing_ms[0]);
+    t.set("graphMs", mlipcpp_graph_timing_ms[1]);
+    t.set("allocMs", mlipcpp_graph_timing_ms[2]);
+    t.set("computeMs", mlipcpp_graph_timing_ms[3]);
+    t.set("resultsMs", mlipcpp_graph_timing_ms[4]);
+    t.set("totalMs", mlipcpp_graph_timing_ms[5]);
+    if (&ggml_webgpu_timing_ms[0] != nullptr) {
+        t.set("gpuEncodeMs", ggml_webgpu_timing_ms[0]);
+        t.set("gpuWaitMs", ggml_webgpu_timing_ms[1]);
+        t.set("gpuReadMs", ggml_webgpu_timing_ms[2]);
+        t.set("gpuReads", ggml_webgpu_timing_ms[3]);
+    }
+    return t;
+}
