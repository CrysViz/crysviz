+// Where the last prediction spent its time (diagnostics, read by the wasm
+// bindings' getLastTimings): [0] neighbour list and inputs, [1] graph build,
+// [2] allocation and constants, [3] graph compute, [4] reading and assembling
+// the results, [5] total. The WebGPU backend's own counters (encode / wait /
+// reads) are reset here too when it is linked in.
+extern "C" {
+double mlipcpp_graph_timing_ms[6] = {0, 0, 0, 0, 0, 0};
+__attribute__((weak)) extern double ggml_webgpu_timing_ms[4];
+}
+
+static double graph_timing_now_ms() {
+  return std::chrono::duration<double, std::milli>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
 ModelResult GraphModel::predict_single(
     const AtomicSystem &system, bool compute_forces,
     const std::function<void()> &post_compute_hook) {
+  const double t_start = graph_timing_now_ms();
+  if (&ggml_webgpu_timing_ms[0] != nullptr) {
+    for (int i = 0; i < 4; i++) ggml_webgpu_timing_ms[i] = 0;
+  }
   if (compute_forces && !forces_mode_) {
     throw std::runtime_error(
         "GraphModel: forces requested but model was exported with "
@@ -827,6 +848,7 @@
   }
 
