+def _merge_lora(model):
+    """Fold LoRA adapters (metatrain fine-tuning with method: lora) into the
+    linear layers they wrap: W' = W + scaling * B @ A. The exported graph and
+    its weight names are then exactly those of the base architecture (LoRA
+    weight names would also pass ggml's 64-character tensor-name limit), and
+    the result is the same function the LoRA model computes."""
+    import torch.nn as nn
+    for name, child in list(model.named_children()):
+        if all(hasattr(child, a) for a in ("linear", "lora_A", "lora_B", "scaling")):
+            base = child.linear
+            merged = nn.Linear(base.in_features, base.out_features, bias=base.bias is not None)
+            with torch.no_grad():
+                merged.weight.copy_(base.weight + child.scaling * (child.lora_B.weight @ child.lora_A.weight))
+                if base.bias is not None:
+                    merged.bias.copy_(base.bias)
+            setattr(model, name, merged.to(base.weight.dtype))
+        else:
+            _merge_lora(child)
+    return model
+
+
