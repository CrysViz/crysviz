{
  "name": "CrysViz",
  "short_name": "CrysViz",
  "description": "Crystal structure viewer in the browser.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#002121",
  "theme_color": "#002121",
  "icons": [
    { "src": "data/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "data/pwa/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-cif": [".cif", ".mcif"],
        "application/x-xyz": [".xyz", ".exyz"],
        "application/x-gaussian-cube": [".cube"],
        "application/x-crysviz": [".crysviz"],
        "application/x-ase-trajectory": [".traj"],
        "application/x-vasp-poscar": [".vasp", ".poscar"],
        "application/x-castep": [".cell", ".geom"],
        "application/x-shelx-res": [".res"],
        "application/x-fhi-aims": [".aims"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
