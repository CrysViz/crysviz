.compare-group {
  margin: 25px 0;
  padding: 20px;
  background: rgba(42, 42, 42, 0.8);
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
}

.compare-group h1 {
  margin: 0 0 15px 0;
  color:  #FFBF00;
  font-size: 16px;
  font-weight: 500;
}

.compare-group h3 {
  margin: 0 0 15px 0;
  color: #81c784;
  font-size: 16px;
  font-weight: 500;
}

.second-input-mode-toggle {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
  margin-bottom: 15px;
  background: rgba(255, 255, 255, 0.05);
  padding: 6px;
  border-radius: 10px;
}

.second-input-mode-btn {
  background: transparent;
  color: #ddd;
  border: none;
  padding: 10px 12px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease;
}

.second-input-mode-btn:hover {
  background: rgba(6, 71, 50, 0.5);
  color: #fff;
}

.second-input-mode-btn.active {
  background: rgba(6, 140, 50, 0.85);
  color: #fff;
}

.second-input-mode-panel {
  display: block;
}

.second-input-mode-panel[hidden] {
  display: none !important;
}

#secondFileInput {
  display: none;
}

#secondFileLabel {
  display: block;
  padding: 15px 20px;
  background: rgba(6, 71, 50, 1);
  color: white;
  text-align: center;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 500;
  transition: all 0.3s ease;
  border: 2px dashed transparent;
}

#secondFileLabel:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(6, 140, 50, 0.4);
}

#secondFileLabel.dragover {
  border: 2px dashed rgba(6, 140, 50, 1);
  background: rgba(6, 71, 50, 0.4);
}

#secondStructureText {
  width: 100%;
  min-height: 160px;
  padding: 12px;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(0, 0, 0, 0.2);
  color: #f5f5f5;
  resize: vertical;
  font-family: 'Fira Code', 'SFMono-Regular', ui-monospace, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
  font-size: 13px;
  line-height: 1.4;
  box-sizing: border-box;
}

#secondStructureText::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

#secondLoadTextButton {
  margin-top: 12px;
  width: 100%;
  padding: 12px 16px;
  background: linear-gradient(45deg, #368f6e, #256951);
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

#secondLoadTextButton:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 18px rgba(54, 143, 110, 0.35);
}
